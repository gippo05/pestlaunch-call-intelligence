    ".next/m5-review-build-20261029-a1873e/dev/types/**/*.ts",
    ".next/m5-review-build-final-20261029-a1873e/types/**/*.ts",
    ".next/m5-review-build-final-20261029-a1873e/dev/types/**/*.ts",
    "m5-review-build-20261029-a1873e/types/**/*.ts",
    "m5-review-build-20261029-a1873e/dev/types/**/*.ts",
    ".next/m5-review-bounded-final-20261029/types/**/*.ts",
    ".next/m5-review-bounded-final-20261029/dev/types/**/*.ts",
    ".next/m5-review-final-full-20261029/types/**/*.ts",
    ".next/m5-review-final-full-20261029/dev/types/**/*.ts",
