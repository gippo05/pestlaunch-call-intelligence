# Copy to .env.local and fill from the owner-approved PestLaunch project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only modern key. Required for local M2 upload operations.
# Never prefix this variable with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SECRET_KEY=

# Local synthetic-only M3 finalization trigger. Keep processing disabled until
# an operator explicitly authorizes a local provider attempt.
M3_PROCESSING_ENABLED=false
M3_SYNTHETIC_ONLY=true
M3_WORKER_AUTH_SECRET=

# Optional hosted synthetic demo dispatch. Defaults to OFF.
# Only enables the single hard-pinned PestLaunch Test Supabase project,
# and only for server-verified SHA allowlisted, one-attempt synthetic fixtures.
# Set on trusted Vercel server runtime only; NEVER set for real customer audio.
M3_HOSTED_SYNTHETIC_DISPATCH_ENABLED=false

# Optional secret for an OWNER-APPROVED trusted scheduler invoking
# GET /api/internal/m3-synthetic-pump. Leave the schedule disabled until
# the provider billing, fixture allowlist, and hosting policy are approved.
CRON_SECRET=
